GEMINI_API_KEY=your_ai_studio_key
LLM_MODEL_CHEAP=gemini-3.5-flash-lite
LLM_MODEL_STRONG=gemini-3.5-flash-lite
LLM_BASE_URL=
GRAPH_ROOT=myproj
ABSTAIN_MIN_SCORE=1
ROUTER_MIN_CONF=0.5
COMMUNITY_LEVEL=2
# Graph store: neo4j (docker compose up -d) or kuzu (embedded fallback, no Docker needed)
GRAPH_BACKEND=neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me_please
KUZU_PATH=myproj/kuzu
CHROMA_PATH=myproj/chroma
